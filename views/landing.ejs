    </div> <script>
        const lpBtn = document.getElementById('lp-hamburger-btn');
        const lpDrawer = document.getElementById('lp-drawer');

        if (lpBtn && lpDrawer) {
            lpBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                lpDrawer.classList.toggle('active');

                // Animate hamburger lines to X configuration smoothly
                const lines = lpBtn.querySelectorAll('span');
                if (lpDrawer.classList.contains('active')) {
                    lines[0].style.transform = 'translateY(8px) rotate(45deg)';
                    lines[1].style.opacity = '0';
                    lines[2].style.transform = 'translateY(-8px) rotate(-45deg)';
                } else {
                    lines[0].style.transform = 'none';
                    lines[1].style.opacity = '1';
                    lines[2].style.transform = 'none';
                }
            });

            // Close the overlay when clicking anywhere outside the menu drawer canvas area
            document.addEventListener('click', (e) => {
                if (!lpDrawer.contains(e.target) && !lpBtn.contains(e.target) && lpDrawer.classList.contains('active')) {
                    lpDrawer.classList.remove('active');
                    const lines = lpBtn.querySelectorAll('span');
                    lines[0].style.transform = 'none';
                    lines[1].style.opacity = '1';
                    lines[2].style.transform = 'none';
                }
            });

            // Smooth collapse drawer when jumping between internal page hashes
            lpDrawer.querySelectorAll('a').forEach(targetLink => {
                targetLink.addEventListener('click', () => {
                    lpDrawer.classList.remove('active');
                    const lines = lpBtn.querySelectorAll('span');
                    lines[0].style.transform = 'none';
                    lines[1].style.opacity = '1';
                    lines[2].style.transform = 'none';
                });
            });
        }
    </script>
</body>
</html>
