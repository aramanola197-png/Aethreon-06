<!DOCTYPE html>
<html lang="en">
<head>

<div style="width: 100%; max-width: 100vw; overflow-x: hidden; margin: 0; padding: 0;">
  
    <style>
    /* 1. Expand the top nav space completely to the screen edges */
    header, .nav-container, [class*="nav"] { 
      padding-left: 2rem !important; 
      padding-right: 2rem !important;
      width: 100% !important;
      box-sizing: border-box !important;
    }

    /* 2. KILL THE DOT: Nuke the bullet point/dot leak next to your logo */
    header ul, header li, li[class*="logo"], div[class*="logo"], [class*="brand"] {
      list-style: none !important;
      list-style-type: none !important;
      margin-left: 0 !important;
      padding-left: 0 !important;
    }
    
    header li::before, [class*="logo"]::before {
      content: none !important;
      display: none !important;
    }

    /* 3. FIX THE TEXT SPLIT: Lock "AETHREON IQ" on one single premium line */
    header a, header div, span[class*="logo"], a[class*="logo"], [class*="brand"], .logo-text {
      white-space: nowrap !important;
      display: inline-flex !important;
      align-items: center !important;
    }
  </style>

  
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AETHREON IQ — Advanced Web3 Intelligence Platform</title>
    
    <!-- Dynamic SVG Favicon Configuration (Keeps tabs clean and branded) -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🛡️</text></svg>">

    <!-- Global App Stylesheets Override Protection -->
    <link rel="stylesheet" href="/css/app.css">

    <!-- Fonts requested by your design system -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&family=Ubuntu+Mono&family=Ubuntu:wght@400;500;700&display=swap" rel="stylesheet">

    <style>
        /* ───────────────────────── AETHREON IQ DESIGN SYSTEM INTEGRATION ───────────────────────── */
        :root {
            --bg:        #192547;
            --bg-2:      #1f2c54;
            --bg-3:      #243365;
            --particle:  #7BBDE8;

            --text:      #FFEDBD;
            --text-dim:  rgba(255,237,189,0.66);
            --text-mute: rgba(255,237,189,0.4);

            --accent:    #AD8411;
            --accent-2:  #d4a531;

            --line:      rgba(173,132,17,0.28);
            --line-soft: rgba(255,237,189,0.08);

            --panel-bg:  rgba(25,37,71,0.86);
            --panel-blur: saturate(140%) blur(18px);

            --shadow:    0 30px 80px -30px rgba(0,0,0,0.7);

            --radius:    14px;
            --radius-sm: 10px;

            --geist:     'Geist', system-ui, -apple-system, 'Segoe UI', sans-serif;
            --mont:      'Montserrat', system-ui, sans-serif;
            --ubuntu:    'Ubuntu', system-ui, sans-serif;
            --mono:      'Ubuntu Mono', ui-monospace, 'SF Mono', Menlo, monospace;
        }

        /* Base Resets scoped strictly using specific body tag class to avoid bleeding */
        body.aethreon-lp {
            background-color: var(--bg) !important;
            color: var(--text) !important;
            font-family: var(--ubuntu);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        /* Precise Text Layout Scales (No random text sizes) */
        .lp-hero-title { font-family: var(--mont); font-size: 3.5rem; font-weight: 800; line-height: 1.15; letter-spacing: -0.02em; color: var(--text); margin: 0; }
        .lp-section-title { font-family: var(--mont); font-size: 2.5rem; font-weight: 700; line-height: 1.2; color: var(--text); margin: 0 0 1rem 0; letter-spacing: -0.01em; }
        .lp-subsection-title { font-family: var(--mont); font-size: 1.75rem; font-weight: 700; line-height: 1.3; color: var(--accent-2); margin: 0 0 1rem 0; }
        .lp-body-lead { font-size: 1.25rem; line-height: 1.6; color: var(--text-dim); }
        .lp-body-normal { font-size: 1.05rem; line-height: 1.6; color: var(--text-dim); }
        .lp-body-code { font-family: var(--mono); font-size: 0.95rem; color: var(--particle); }
        .lp-body-small { font-size: 0.875rem; line-height: 1.5; color: var(--text-mute); }

        /* Pure Glassmorphic Containers */
        .lp-glass-panel {
            background: var(--panel-bg);
            backdrop-filter: var(--panel-blur);
            -webkit-backdrop-filter: var(--panel-blur);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
        }
        .lp-glass-panel:hover {
            border-color: var(--accent-2);
            box-shadow: 0 0 25px rgba(212, 165, 49, 0.15);
            transform: translateY(-2px);
        }

        /* Structured Layout Configurations */
        .lp-header {
            height: 90px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 8%;
            border-bottom: 1px solid var(--line-soft);
            position: sticky;
            top: 0;
            background: rgba(25, 37, 71, 0.92);
            backdrop-filter: blur(12px);
            z-index: 1000;
        }

        .lp-split-hero {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            min-height: calc(100vh - 90px);
            align-items: center;
            padding: 0 8%;
            gap: 4rem;
            position: relative;
        }

        /* Vector Accent Graphic Placements instead of Emojis */
        .lp-vector-accent {
            width: 48px;
            height: 4px;
            background: var(--accent);
            margin-bottom: 1.5rem;
            border-radius: 2px;
        }

        /* Action Buttons */
        .lp-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 14px 28px;
            font-family: var(--mont);
            font-weight: 700;
            font-size: 1rem;
            text-decoration: none;
            border-radius: var(--radius-sm);
            transition: all 0.25s ease;
            cursor: pointer;
        }
        .lp-btn-primary {
            background: var(--accent);
            color: var(--text);
            border: 1px solid var(--accent-2);
        }
        .lp-btn-primary:hover {
            background: var(--accent-2);
            box-shadow: 0 0 15px rgba(212, 165, 49, 0.4);
            transform: translateY(-2px);
        }
        .lp-btn-secondary {
            background: transparent;
            color: var(--text);
            border: 1px solid var(--line);
        }
        .lp-btn-secondary:hover {
            background: rgba(255, 237, 189, 0.05);
            border-color: var(--text-dim);
            transform: translateY(-2px);
        }

        /* Mobile Responsive System */
        .lp-hamburger {
            display: none;
            flex-direction: column;
            gap: 6px;
            cursor: pointer;
        }
        .lp-hamburger span {
            width: 30px;
            height: 3px;
            background-color: var(--text);
            transition: 0.3s ease;
            border-radius: 2px;
        }

        .lp-mobile-drawer {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background: var(--bg);
            z-index: 999;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 2.5rem;
            transform: translateY(-100%);
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .lp-mobile-drawer.active {
            transform: translateY(0);
        }

        @media (max-width: 1024px) {
            .lp-hero-title { font-size: 2.75rem; }
            .lp-section-title { font-size: 2rem; }
        }

        @media (max-width: 768px) {
            .lp-split-hero {
                grid-template-columns: 1fr;
                padding: 6rem 6% 4rem 6%;
                text-align: center;
            }
            .lp-desktop-nav { display: none !important; }
            .lp-hamburger { display: flex; }
            .lp-hero-title { font-size: 2.3rem; }
            .lp-panel-side-content { margin: 2rem auto 0 auto; max-width: 440px; }
        }
    </style>
</head>
