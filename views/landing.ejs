<script>
// ── Particle canvas ───────────────────────────────
const canvas = document.getElementById('bg-canvas');
const ctx = canvas.getContext('2d');
let pts = [], W, H;

function resize() {
  W = canvas.width  = window.innerWidth;
  H = canvas.height = window.innerHeight;
}

function init() {
  pts = [];
  const n = Math.floor(W * H / 16000);
  for (let i = 0; i < n; i++) {
    pts.push({
      x: Math.random() * W,
      y: Math.random() * H,
      r: Math.random() * 1.1 + 0.2,
      vx: (Math.random() - 0.5) * 0.16,
      vy: (Math.random() - 0.5) * 0.16,
      a: Math.random() * 0.45 + 0.08,
      warm: Math.random() > 0.6,
    });
  }
}

function draw() {
  ctx.clearRect(0, 0, W, H);
  for (let i = 0; i < pts.length; i++) {
    for (let j = i+1; j < pts.length; j++) {
      const dx = pts[i].x - pts[j].x;
      const dy = pts[i].y - pts[j].y;
      const d  = Math.sqrt(dx*dx + dy*dy);
      if (d < 110) {
        const a = (1 - d/110) * 0.07;
        ctx.beginPath();
        ctx.moveTo(pts[i].x, pts[i].y);
        ctx.lineTo(pts[j].x, pts[j].y);
        ctx.strokeStyle = pts[i].warm
          ? `rgba(212,165,49,${a})`
          : `rgba(123,189,232,${a * 0.6})`;
        ctx.lineWidth = 0.5;
        ctx.stroke();
      }
    }
  }
  pts.forEach(p => {
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
    ctx.fillStyle = p.warm
      ? `rgba(212,165,49,${p.a})`
      : `rgba(123,189,232,${p.a * 0.65})`;
    ctx.fill();
    p.x += p.vx; p.y += p.vy;
    if (p.x < 0) p.x = W; if (p.x > W) p.x = 0;
    if (p.y < 0) p.y = H; if (p.y > H) p.y = 0;
  });
  requestAnimationFrame(draw);
}

resize(); init(); draw();
window.addEventListener('resize', () => { resize(); init(); });

// ── Mobile menu ───────────────────────────────────
function toggleMenu() {
  const d = document.getElementById('mobile-drawer');
  const h = document.getElementById('hamburger');
  const open = d.classList.toggle('open');
  const s = h.querySelectorAll('span');
  if (open) {
    s[0].style.transform = 'translateY(7px) rotate(45deg)';
    s[1].style.opacity = '0';
    s[2].style.transform = 'translateY(-7px) rotate(-45deg)';
  } else {
    s[0].style.transform = ''; s[1].style.opacity = ''; s[2].style.transform = '';
  }
}

function closeMenu() {
  document.getElementById('mobile-drawer').classList.remove('open');
  const s = document.getElementById('hamburger').querySelectorAll('span');
  s[0].style.transform = ''; s[1].style.opacity = ''; s[2].style.transform = '';
}

// ── Scroll reveal ─────────────────────────────────
const obs = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
  });
}, { threshold: 0.1, rootMargin: '0px 0px -36px 0px' });

document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// ── Nav on scroll ─────────────────────────────────
window.addEventListener('scroll', () => {
  document.getElementById('main-nav').style.background =
    window.scrollY > 50 ? 'rgba(25,37,71,0.97)' : 'rgba(25,37,71,0.88)';
});
</script>
