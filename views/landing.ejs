    <style>
        /* ───────────────────────── AETHREON IQ DESIGN SYSTEM INTEGRATION ───────────────────────── */
        :root {
            --bg:        #192547;
            --bg-2:      #1f2c54;
            --bg-3:      #243365;
            --particle:  #7BBDE8;

            --text:      #FFEDBD;
            --text-dim:  rgba(255,237,189,0.66);
            --text-mute: rgba(255,237,189,0.4);

            --accent:    #AD8411;
            --accent-2:  #d4a531;

            --line:      rgba(173,132,17,0.28);
            --line-soft: rgba(255,237,189,0.08);

            --panel-bg:  rgba(25,37,71,0.86);
            --panel-blur: saturate(140%) blur(18px);

            --shadow:    0 30px 80px -30px rgba(0,0,0,0.7);

            --radius:    14px;
            --radius-sm: 10px;

            --geist:     'Geist', system-ui, -apple-system, 'Segoe UI', sans-serif;
            --mont:      'Montserrat', system-ui, sans-serif;
            --ubuntu:    'Ubuntu', system-ui, sans-serif;
            --mono:      'Ubuntu Mono', ui-monospace, 'SF Mono', Menlo, monospace;
        }

        /* Prevent unwanted side scrolling and manage root defaults */
        html, body {
            max-width: 100vw;
            overflow-x: hidden;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        *, *:before, *:after {
            box-sizing: inherit;
        }

        body.aethreon-lp {
            background-color: var(--bg) !important;
            color: var(--text) !important;
            font-family: var(--ubuntu);
            scroll-behavior: smooth;
        }

        /* Precise Text Layout Scales */
        .lp-hero-title { font-family: var(--mont); font-size: 3.5rem; font-weight: 800; line-height: 1.15; letter-spacing: -0.02em; color: var(--text); margin: 0; }
        .lp-section-title { font-family: var(--mont); font-size: 2.5rem; font-weight: 700; line-height: 1.2; color: var(--text); margin: 0 0 1rem 0; letter-spacing: -0.01em; }
        .lp-subsection-title { font-family: var(--mont); font-size: 1.75rem; font-weight: 700; line-height: 1.3; color: var(--accent-2); margin: 0 0 1rem 0; }
        .lp-body-lead { font-size: 1.25rem; line-height: 1.6; color: var(--text-dim); }
        .lp-body-normal { font-size: 1.05rem; line-height: 1.6; color: var(--text-dim); }
        .lp-body-code { font-family: var(--mono); font-size: 0.95rem; color: var(--particle); }
        .lp-body-small { font-size: 0.875rem; line-height: 1.5; color: var(--text-mute); }

        /* Pure Glassmorphic Containers */
        .lp-glass-panel {
            background: var(--panel-bg);
            backdrop-filter: var(--panel-blur);
            -webkit-backdrop-filter: var(--panel-blur);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
        }
        .lp-glass-panel:hover {
            border-color: var(--accent-2);
            box-shadow: 0 0 25px rgba(212, 165, 49, 0.15);
            transform: translateY(-2px);
        }

        /* Structured Layout Configurations */
        .lp-header {
            height: 90px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 8%;
            border-bottom: 1px solid var(--line-soft);
            position: sticky;
            top: 0;
            background: rgba(25, 37, 71, 0.92);
            backdrop-filter: blur(12px);
            z-index: 1000;
            width: 100%;
        }

        /* Brand Layout Locks */
        .brand-container {
            display: flex !important;
            align-items: center !important;
            gap: 14px !important;
            white-space: nowrap !important;
            word-break: keep-all !important;
        }

        .logo-text {
            font-family: var(--mont) !important;
            font-weight: 800 !important;
            font-size: 1.4rem !important;
            letter-spacing: 1px !important;
            white-space: nowrap !important;
            display: inline-block !important;
        }

        .lp-split-hero {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            min-height: calc(100vh - 90px);
            align-items: center;
            padding: 0 8%;
            gap: 4rem;
            position: relative;
        }

        /* Vector Accent Graphic Placements */
        .lp-vector-accent {
            width: 48px;
            height: 4px;
            background: var(--accent);
            margin-bottom: 1.5rem;
            border-radius: 2px;
        }

        /* Action Buttons */
        .lp-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 14px 28px;
            font-family: var(--mont);
            font-weight: 700;
            font-size: 1rem;
            text-decoration: none;
            border-radius: var(--radius-sm);
            transition: all 0.25s ease;
            cursor: pointer;
        }
        .lp-btn-primary {
            background: var(--accent);
            color: var(--text);
            border: 1px solid var(--accent-2);
        }
        .lp-btn-primary:hover {
            background: var(--accent-2);
            box-shadow: 0 0 15px rgba(212, 165, 49, 0.4);
            transform: translateY(-2px);
        }
        .lp-btn-secondary {
            background: transparent;
            color: var(--text);
            border: 1px solid var(--line);
        }
        .lp-btn-secondary:hover {
            background: rgba(255, 237, 189, 0.05);
            border-color: var(--text-dim);
            transform: translateY(-2px);
        }

        /* Mobile Hamburger Toggle Layout Elements */
        .lp-hamburger {
            display: none;
            flex-direction: column;
            gap: 6px;
            cursor: pointer;
            z-index: 1001;
            padding: 5px;
        }
        .lp-hamburger span {
            display: block;
            width: 25px;
            height: 2px;
            background-color: var(--text);
            transition: 0.3s ease;
            border-radius: 2px;
        }

        /* Standardized Slide-out Mobile Menu Drawer Drawer */
        .lp-mobile-drawer {
            position: fixed;
            top: 0;
            right: 0;
            width: 0px; /* Managed strictly via JS transitions */
            height: 100vh;
            background: rgba(25, 37, 71, 0.98);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-left: 1px solid var(--line-soft);
            z-index: 999;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            justify-content: center;
            padding-left: 0;
            gap: 2rem;
            overflow: hidden;
            transition: width 0.35s cubic-bezier(0.16, 1, 0.3, 1), padding 0.35s ease;
        }
        
        .lp-mobile-drawer.active {
            width: 280px;
            padding-left: 2.5rem;
        }
        
        .lp-mobile-drawer a {
            opacity: 0;
            white-space: nowrap;
            transition: opacity 0.2s ease;
        }
        .lp-mobile-drawer.active a {
            opacity: 1;
            transition-delay: 0.15s;
        }

        /* Desktop vs Mobile Breakpoint Controls */
        @media (min-width: 992px) {
            .lp-hamburger { display: none !important; }
            .lp-desktop-nav { display: flex !important; }
        }

        @media (max-width: 991px) {
            .lp-desktop-nav { display: none !important; }
            .lp-hamburger { display: flex !important; }
            
            .lp-split-hero {
                grid-template-columns: 1fr;
                padding: 6rem 6% 4rem 6%;
                text-align: center;
            }
            .lp-hero-title { font-size: 2.3rem; }
            .lp-panel-side-content { margin: 2rem auto 0 auto; max-width: 440px; }
        }
        
                /* ... keeping all your previous CSS styles exactly as they are ... */

        @media (max-width: 768px) {
            .lp-split-hero {
                grid-template-columns: 1fr;
                padding: 6rem 6% 4rem 6%;
                text-align: center;
            }
            .lp-desktop-nav { display: none !important; }
            .lp-hamburger { display: flex; }
            .lp-hero-title { font-size: 2.3rem; }
            .lp-panel-side-content { margin: 2rem auto 0 auto; max-width: 440px; }
        }

        /* 🔽 PASTE THE NEW RESPONSIVE OVERRIDES HERE RIGHT BEFORE THE STYLE BLOCK CLOSES 🔽 */
        @media (min-width: 992px) {
            .mobile-only-hamburger { 
                display: none !important; 
