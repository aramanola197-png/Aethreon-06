<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Aethreon IQ — Reputation Intelligence for Web3</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Ubuntu:wght@300;400;500;700&family=Ubuntu+Mono:wght@400;700&display=swap" rel="stylesheet"/>

<link rel="stylesheet" href="/css/app.css">

<style>
/* ═══════════════════════════════════════════
   AETHREON IQ — BRAND DESIGN SYSTEM
═══════════════════════════════════════════ */
:root {
  --bg:        #192547;
  --bg-2:      #1f2c54;
  --bg-3:      #243365;
  --particle:  #7BBDE8;

  --text:      #FFEDBD;
  --text-dim:  rgba(255,237,189,0.66);
  --text-mute: rgba(255,237,189,0.4);

  --accent:    #AD8411;
  --accent-2:  #d4a531;

  --line:      rgba(173,132,17,0.28);
  --line-soft: rgba(255,237,189,0.08);

  --panel-bg:  rgba(25,37,71,0.86);
  --panel-blur: saturate(140%) blur(18px);

  --shadow:    0 30px 80px -30px rgba(0,0,0,0.7);

  --radius:    14px;
  --radius-sm: 10px;

  --mont:  'Montserrat', system-ui, sans-serif;
  --ubuntu:'Ubuntu', system-ui, sans-serif;
  --mono:  'Ubuntu Mono', ui-monospace, monospace;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--ubuntu);
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 2px; }

/* ── Canvas ── */
#bg-canvas {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: 0.55;
}

/* ════════════════════════════════
   NAV
════════════════════════════════ */
.lp-header {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 200;
  height: 80px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6%;
  background: rgba(25, 37, 71, 0.88);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--line-soft);
  transition: background 0.3s;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 14px;
  text-decoration: none;
}

.brand-orb {
  width: 38px; height: 38px;
  border-radius: 50%;
  border: 1.5px solid var(--accent-2);
  display: flex; align-items: center; justify-content: center;
  background: rgba(173,132,17,0.12);
  flex-shrink: 0;
  position: relative;
}

.brand-orb::after {
  content: '';
  position: absolute;
  inset: 5px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(212,165,49,0.3), transparent 70%);
}

.brand-orb-letter {
  font-family: var(--mont);
  font-weight: 900;
  font-size: 16px;
  color: var(--accent-2);
  line-height: 1;
  z-index: 1;
}

.brand-name {
  font-family: var(--mont);
  font-weight: 800;
  font-size: 1.25rem;
  letter-spacing: 0.06em;
  color: var(--text);
  white-space: nowrap;
}

.brand-name span { color: var(--accent-2); }

.nav-links {
  display: flex;
  align-items: center;
  gap: 2.2rem;
  list-style: none;
}

.nav-links a {
  font-family: var(--ubuntu);
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--text-dim);
  text-decoration: none;
  letter-spacing: 0.03em;
  transition: color 0.2s;
  position: relative;
}

.nav-links a::after {
  content: '';
  position: absolute;
  bottom: -3px; left: 0; right: 100%;
  height: 1px;
  background: var(--accent-2);
  transition: right 0.25s ease;
}

.nav-links a:hover { color: var(--text); }
.nav-links a:hover::after { right: 0; }

.nav-cta {
  font-family: var(--mont) !important;
  font-weight: 700 !important;
  font-size: 0.82rem !important;
  letter-spacing: 0.08em !important;
  background: var(--accent) !important;
  color: var(--text) !important;
  padding: 10px 22px;
  border-radius: var(--radius-sm);
  transition: background 0.2s, box-shadow 0.2s !important;
}

.nav-cta:hover {
  background: var(--accent-2) !important;
  box-shadow: 0 6px 22px rgba(173,132,17,0.35) !important;
}

.nav-cta::after { display: none !important; }

/* Mobile hamburger */
.hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  cursor: pointer;
  padding: 4px;
}
.hamburger span {
  display: block; width: 24px; height: 2px;
  background: var(--text);
  border-radius: 1px;
  transition: transform 0.3s, opacity 0.3s;
}

.drawer-overlay {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 198;
  background: rgba(10, 16, 36, 0.6);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  opacity: 0;
  transition: opacity 0.35s ease;
  cursor: pointer;
}

.drawer-overlay.open {
  opacity: 1;
  pointer-events: auto;
}

.mobile-drawer {
  display: none;
  position: fixed;
  top: 80px; right: 0;
  width: 280px; height: calc(100vh - 80px);
  background: rgba(21, 32, 64, 0.97);
  backdrop-filter: blur(24px);
  border-left: 1px solid var(--line);
  flex-direction: column;
  padding: 3rem 2.5rem;
  gap: 2rem;
  z-index: 199;
  transform: translateX(100%);
  transition: transform 0.35s cubic-bezier(0.16,1,0.3,1);
}

.mobile-drawer.open { transform: translateX(0); }

.mobile-drawer a {
  font-family: var(--mont);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text-dim);
  text-decoration: none;
  letter-spacing: 0.08em;
  transition: color 0.2s;
}

.mobile-drawer a:hover { color: var(--accent-2); }

@media (max-width: 880px) {
  .nav-links { display: none; }
  .hamburger { display: flex; }
  .mobile-drawer { display: flex; }
  .drawer-overlay { display: block; pointer-events: none; }
}

/* ════════════════════════════════
   HERO
════════════════════════════════ */
.hero {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  align-items: center;
  padding: 80px 6% 0;
  gap: 4rem;
  overflow: hidden;
}

@media (max-width: 960px) {
  .hero { grid-template-columns: 1fr; padding-top: 80px; }
  .hero-panel { display: none; }
}

/* Subtle grid bg texture */
.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(var(--line-soft) 1px, transparent 1px),
    linear-gradient(90deg, var(--line-soft) 1px, transparent 1px);
  background-size: 72px 72px;
  pointer-events: none;
  z-index: 0;
}

.hero-content {
  position: relative;
  z-index: 2;
  padding: 7rem 0 6rem;
}

/* Eyebrow */
.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 2rem;
  opacity: 0;
  animation: fadeUp 0.7s 0.15s ease forwards;
}

.eyebrow-pip {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--accent-2);
  animation: pip-pulse 2.5s infinite;
}

@keyframes pip-pulse {
  0%,100% { opacity: 1; box-shadow: 0 0 0 0 rgba(212,165,49,0.5); }
  50% { opacity: 0.7; box-shadow: 0 0 0 5px rgba(212,165,49,0); }
}

.eyebrow-txt {
  font-family: var(--mono);
  font-size: 0.75rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--accent-2);
}

/* Headline */
.hero-title {
  font-family: var(--mont);
  font-size: clamp(2.6rem, 6vw, 5rem);
  font-weight: 900;
  line-height: 1.05;
  letter-spacing: -0.025em;
  color: var(--text);
  margin-bottom: 1.5rem;
  opacity: 0;
  animation: fadeUp 0.8s 0.3s ease forwards;
}

.hero-title-accent {
  display: block;
  color: var(--accent-2);
  position: relative;
}

/* Decorative underline on accent */
.hero-title-accent::after {
  content: '';
  position: absolute;
  bottom: -6px; left: 0;
  width: 60%; height: 2px;
  background: linear-gradient(90deg, var(--accent), transparent);
  border-radius: 1px;
}

/* Sub */
.hero-sub {
  font-size: 1.1rem;
  font-weight: 300;
  line-height: 1.75;
  color: var(--text-dim);
  max-width: 540px;
  margin-bottom: 2.5rem;
  opacity: 0;
  animation: fadeUp 0.8s 0.45s ease forwards;
}

/* Actions */
.hero-actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  opacity: 0;
  animation: fadeUp 0.8s 0.6s ease forwards;
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: var(--accent);
  color: var(--text);
  font-family: var(--mont);
  font-weight: 700;
  font-size: 0.88rem;
  letter-spacing: 0.06em;
  padding: 15px 30px;
  border-radius: var(--radius-sm);
  text-decoration: none;
  transition: all 0.25s ease;
  box-shadow: 0 8px 24px rgba(173,132,17,0.25);
}

.btn-primary:hover {
  background: var(--accent-2);
  transform: translateY(-2px);
  box-shadow: 0 14px 32px rgba(173,132,17,0.4);
}

.btn-primary svg { transition: transform 0.2s; }
.btn-primary:hover svg { transform: translateX(4px); }

.btn-outline {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: transparent;
  color: var(--text-dim);
  font-family: var(--ubuntu);
  font-weight: 500;
  font-size: 0.88rem;
  padding: 15px 28px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--line);
  text-decoration: none;
  transition: all 0.25s ease;
}

.btn-outline:hover {
  color: var(--text);
  border-color: var(--accent);
  background: rgba(173,132,17,0.07);
}

/* ── Hero right panel ── */
.hero-panel {
  position: relative;
  z-index: 2;
  opacity: 0;
  animation: fadeLeft 1s 0.8s ease forwards;
}

.panel-card {
  background: var(--panel-bg);
  backdrop-filter: var(--panel-blur);
  -webkit-backdrop-filter: var(--panel-blur);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow), inset 0 1px 0 rgba(212,165,49,0.1);
  position: relative;
}

.scan-line {
  position: absolute;
  left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, var(--accent-2), transparent);
  animation: scan 4s linear infinite;
  z-index: 10;
  pointer-events: none;
}

@keyframes scan {
  0% { top: 0; opacity: 0; }
  5% { opacity: 0.8; }
  95% { opacity: 0.8; }
  100% { top: 100%; opacity: 0; }
}

.panel-bar {
  padding: 13px 18px;
  border-bottom: 1px solid var(--line-soft);
  display: flex;
  align-items: center;
  gap: 7px;
  background: rgba(36,51,101,0.6);
}

.pdot { width: 9px; height: 9px; border-radius: 50%; }

.panel-bar-title {
  font-family: var(--mono);
  font-size: 0.7rem;
  color: var(--text-mute);
  letter-spacing: 0.1em;
  margin-left: 6px;
}

.panel-body { padding: 22px 20px; }

.panel-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 9px 0;
  border-bottom: 1px solid var(--line-soft);
  font-size: 0.8rem;
}

.panel-row:last-of-type { border-bottom: none; }

.pkey { font-family: var(--mono); color: var(--text-mute); font-size: 0.72rem; }
.pval { font-family: var(--mono); font-size: 0.72rem; }
.v-green { color: #6fde9e; }
.v-gold  { color: var(--accent-2); }
.v-blue  { color: var(--particle); }

.panel-score {
  margin-top: 18px;
  padding: 18px;
  background: rgba(173,132,17,0.08);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  text-align: center;
}

.score-num {
  font-family: var(--mont);
  font-size: 3.2rem;
  font-weight: 900;
  color: var(--accent-2);
  line-height: 1;
  letter-spacing: -0.03em;
}

.score-label {
  font-family: var(--mono);
  font-size: 0.65rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--text-mute);
  margin-top: 6px;
}

/* ════════════════════════════════
   SHARED SECTION UTILS
════════════════════════════════ */
.section {
  position: relative;
  z-index: 1;
  padding: 7rem 6%;
}

.section-alt {
  background: var(--bg-2);
  border-top: 1px solid var(--line-soft);
  border-bottom: 1px solid var(--line-soft);
}

.section-center { text-align: center; }

.section-tag {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 1.25rem;
}

.tag-line { width: 28px; height: 1px; background: var(--accent); flex-shrink: 0; }

.tag-txt {
  font-family: var(--mono);
  font-size: 0.7rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--accent-2);
}

.section-title {
  font-family: var(--mont);
  font-size: clamp(1.8rem, 3.5vw, 2.6rem);
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.02em;
  color: var(--text);
  margin-bottom: 1.1rem;
}

.section-lead {
  font-size: 1.05rem;
  font-weight: 300;
  line-height: 1.75;
  color: var(--text-dim);
  max-width: 600px;
}

/* Scroll reveal */
.reveal {
  opacity: 0;
  transform: translateY(28px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}
.reveal.visible { opacity: 1; transform: none; }
.rd1 { transition-delay: 0.08s; }
.rd2 { transition-delay: 0.16s; }
.rd3 { transition-delay: 0.24s; }
.rd4 { transition-delay: 0.32s; }

/* ════════════════════════════════
   STATS STRIP
════════════════════════════════ */
.stats-strip {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid var(--line-soft);
  border-bottom: 1px solid var(--line-soft);
  background: rgba(25,37,71,0.7);
}

.stat-cell {
  padding: 3.5rem 5%;
  text-align: center;
  border-right: 1px solid var(--line-soft);
  position: relative;
  overflow: hidden;
}

.stat-cell:last-child { border-right: none; }

.stat-cell::after {
  content: '';
  position: absolute;
  bottom: 0; left: 50%; transform: translateX(-50%);
  width: 0; height: 2px;
  background: var(--accent);
  transition: width 0.4s ease;
  border-radius: 1px;
}

.stat-cell:hover::after { width: 50%; }

.stat-num {
  font-family: var(--mont);
  font-size: clamp(2.2rem, 4vw, 3.5rem);
  font-weight: 900;
  letter-spacing: -0.03em;
  color: var(--accent-2);
  line-height: 1;
  margin-bottom: 0.5rem;
}

.stat-num.blue { color: var(--particle); }

.stat-lbl {
  font-family: var(--mono);
  font-size: 0.68rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--text-mute);
}

@media (max-width: 640px) {
  .stats-strip { grid-template-columns: 1fr; }
  .stat-cell { border-right: none; border-bottom: 1px solid var(--line-soft); }
  .stat-cell:last-child { border-bottom: none; }
}

/* ════════════════════════════════
   FEATURE CARDS
════════════════════════════════ */
.cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
  gap: 1.5rem;
  margin-top: 4rem;
}

.feature-card {
  background: var(--panel-bg);
  backdrop-filter: var(--panel-blur);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 2.5rem;
  transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s;
  position: relative;
  overflow: hidden;
}

.feature-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, var(--accent), transparent);
  opacity: 0;
  transition: opacity 0.3s;
}

.feature-card:hover {
  border-color: var(--accent-2);
  box-shadow: 0 0 28px rgba(173,132,17,0.14);
  transform: translateY(-3px);
}

.feature-card:hover::before { opacity: 1; }

.card-icon {
  width: 46px; height: 46px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--line);
  background: rgba(173,132,17,0.08);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 1.5rem;
  color: var(--accent-2);
  transition: background 0.3s, border-color 0.3s;
}

.feature-card:hover .card-icon {
  background: rgba(173,132,17,0.15);
  border-color: var(--accent);
}

.card-index {
  font-family: var(--mono);
  font-size: 0.65rem;
  letter-spacing: 0.2em;
  color: var(--accent);
  opacity: 0.7;
  margin-bottom: 0.6rem;
  text-transform: uppercase;
}

.card-title {
  font-family: var(--mont);
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 0.75rem;
}

.card-body {
  font-size: 0.92rem;
  font-weight: 300;
  line-height: 1.7;
  color: var(--text-dim);
}

/* ════════════════════════════════
   VISION / MANIFESTO
════════════════════════════════ */
.manifesto-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
}

@media (max-width: 800px) {
  .manifesto-grid { grid-template-columns: 1fr; gap: 3rem; }
}

.manifesto-quote-box {
  background: var(--panel-bg);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 3rem;
  backdrop-filter: var(--panel-blur);
  position: relative;
}

.q-mark {
  position: absolute;
  top: -1rem; left: 2rem;
  font-family: var(--mont);
  font-size: 7rem;
  font-weight: 900;
  color: var(--accent);
  opacity: 0.1;
  line-height: 1;
  pointer-events: none;
}

.q-text {
  font-family: var(--ubuntu);
  font-size: 1.2rem;
  font-weight: 300;
  line-height: 1.65;
  color: var(--text);
  font-style: italic;
  position: relative;
  z-index: 1;
}

.q-attr {
  margin-top: 1.5rem;
  font-family: var(--mono);
  font-size: 0.68rem;
  letter-spacing: 0.15em;
  color: var(--accent-2);
  text-transform: uppercase;
}

/* ════════════════════════════════
   FRAMEWORK ROWS
════════════════════════════════ */
.rule-table {
  margin-top: 4rem;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
}

.rule-row {
  display: grid;
  grid-template-columns: 90px 1fr auto;
  align-items: center;
  gap: 2rem;
  padding: 1.75rem 2.25rem;
  border-bottom: 1px solid var(--line-soft);
  transition: background 0.25s;
}

.rule-row:last-child { border-bottom: none; }
.rule-row:hover { background: rgba(173,132,17,0.05); }

.rule-idx {
  font-family: var(--mono);
  font-size: 0.68rem;
  letter-spacing: 0.15em;
  color: var(--accent);
  opacity: 0.65;
  white-space: nowrap;
}

.rule-title {
  font-family: var(--mont);
  font-size: 0.98rem;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 3px;
}

.rule-desc {
  font-size: 0.85rem;
  font-weight: 300;
  color: var(--text-dim);
  line-height: 1.5;
}

.rule-badge {
  display: flex;
  align-items: center;
  gap: 6px;
  font-family: var(--mono);
  font-size: 0.65rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  white-space: nowrap;
}

.badge-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
}

.badge-live { color: #6fde9e; }
.badge-live .badge-dot { background: #6fde9e; animation: blink 2s infinite; }

.badge-beta { color: var(--accent-2); }
.badge-beta .badge-dot { background: var(--accent-2); }

@keyframes blink {
  0%,100% { opacity: 1; }
  50% { opacity: 0.35; }
}

@media (max-width: 640px) {
  .rule-row { grid-template-columns: 1fr; gap: 0.5rem; }
}

/* ════════════════════════════════
   CTA
════════════════════════════════ */
.cta-section {
  position: relative;
  z-index: 1;
  padding: 9rem 6%;
  text-align: center;
  overflow: hidden;
