            .desktop-only-links { 
                display: flex !important; 
            }
        }

        @media (max-width: 991px) {
            .desktop-only-links { 
                display: none !important; 
            }
            .mobile-only-hamburger { 
                display: flex !important; 
            }
        }
    
    </style>

