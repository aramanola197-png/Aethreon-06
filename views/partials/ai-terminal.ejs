<div id="ai-terminal" class="panel panel-terminal" role="dialog" aria-label="AETHREON IQ Assistant" hidden>
  <div class="panel-head">
    <span class="panel-title">AETHREON · ASSISTANT</span>
    <button class="panel-close icon-btn" data-close="ai-terminal" aria-label="Close">×</button>
  </div>
  <div class="terminal-body" id="ai-log">
    <div class="ai-line ai-line-bot"><span class="ai-prompt">»</span><span id="ai-greet"></span></div>
  </div>
  <form id="ai-form" class="terminal-form">
    <span class="ai-prompt">›</span>
    <input id="ai-input" type="text" autocomplete="off" placeholder="Ask about navigation or utilities…" />
    <button type="submit" class="ai-send" aria-label="Send">↵</button>
  </form>
</div>
