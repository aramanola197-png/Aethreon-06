<header class="topbar">

  <div class="topbar-left">

    <button id="hamburger" class="icon-btn only-mobile" aria-label="Open menu">
      <svg viewBox="0 0 24 24" width="20" height="20">
        <path fill="currentColor" d="M3 6h18v2H3zM3 11h18v2H3zM3 16h18v2H3z"/>
      </svg>
    </button>

    <img
      src="/images/logo-brandname.jpg"
      alt="AETHREON IQ"
      class="topbar-logo"
    />

    <h1 class="topbar-title">
      <%= pageTitle || 'AETHREON IQ' %>
    </h1>

  </div>

  <div class="topbar-right">

    <button id="control-btn" class="ctrl-btn" aria-label="Open control panel">
      <svg viewBox="0 0 24 24" width="16" height="16">
        <path fill="currentColor" d="M3 5h18v2H3zM3 11h12v2H3zM3 17h18v2H3z"/>
      </svg>

      <span>Control</span>
    </button>

   <a href="/auth/logout" id="logout-btn" class="ctrl-btn" aria-label="Logout">
  <svg viewBox="0 0 24 24" width="16" height="16">
    <path fill="currentColor" d="M16 17v-3H9v-4h7V7l5 5-5 5M14 2a2 2 0 0 1 2 2v2h-2V4H5v16h9v-2h2v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9z"/>
  </svg>
  <span>Logout</span>
</a>


    <button id="notif-btn" class="icon-btn notif" aria-label="Open notifications">

      <svg viewBox="0 0 24 24" width="18" height="18">
        <path fill="currentColor" d="M12 22a2.5 2.5 0 0 0 2.5-2.5h-5A2.5 2.5 0 0 0 12 22zm7-6V11a7 7 0 0 0-5-6.7V4a2 2 0 1 0-4 0v.3A7 7 0 0 0 5 11v5l-2 2v1h18v-1z"/>
      </svg>

      <span id="notif-dot" class="notif-dot" hidden></span>

    </button>

  </div>

</header>
