<header class="topbar">
  <div class="topbar-left">
    <button id="hamburger" class="icon-btn only-mobile" aria-label="Open menu">
      <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M3 6h18v2H3zM3 11h18v2H3zM3 16h18v2H3z"/></svg>
    </button>
    <img src="/images/logo-brandname.jpg" alt="AETHREON IQ" class="topbar-logo" />
    <h1 class="topbar-title"><%= pageTitle || 'AETHREON IQ' %></h1>
  </div>
  <div class="topbar-right">
    <button id="avatar-btn" class="avatar-btn" aria-label="Select avatar">
      <span id="avatar-glyph" class="avatar-glyph">◈</span>
    </button>
    <button id="control-btn" class="ctrl-btn" aria-label="Open control panel">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm9.4 4c0-.5 0-1-.1-1.5l2.1-1.6-2-3.5-2.5 1a7.9 7.9 0 0 0-2.6-1.5L15.9 2h-4l-.4 2.9a7.9 7.9 0 0 0-2.6 1.5l-2.5-1-2 3.5L6.6 10.5C6.5 11 6.5 11.5 6.5 12s0 1 .1 1.5L4.5 15l2 3.5 2.5-1a7.9 7.9 0 0 0 2.6 1.5l.4 2.9h4l.4-2.9a7.9 7.9 0 0 0 2.6-1.5l2.5 1 2-3.5-2.1-1.6c.1-.5.1-1 .1-1.5z" opacity=".0"/><path fill="currentColor" d="M3 5h18v2H3zM3 11h12v2H3zM3 17h18v2H3z"/></svg>
      <span>Control</span>
    </button>
    <button id="notif-btn" class="icon-btn notif" aria-label="Open notifications">
      <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 22a2.5 2.5 0 0 0 2.5-2.5h-5A2.5 2.5 0 0 0 12 22zm7-6V11a7 7 0 0 0-5-6.7V4a2 2 0 1 0-4 0v.3A7 7 0 0 0 5 11v5l-2 2v1h18v-1z"/></svg>
      <span id="notif-dot" class="notif-dot" hidden></span>
    </button>
  </div>
</header>
