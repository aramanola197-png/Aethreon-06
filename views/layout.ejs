<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#192547" />
  <title><%= title %></title>
  <meta name="description" content="AETHREON IQ — premium Web3 reputation intelligence platform powered by the Zero Authority DAO API." />
  <link rel="icon" type="image/jpeg" href="/images/logo-brandname.jpg" />
  <link rel="apple-touch-icon" href="/images/logo-brandname.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Montserrat:wght@400;500;600&family=Ubuntu+Mono:wght@400;700&family=Ubuntu:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body data-page="<%= pageTitle %>">
  <canvas id="bg-particles" aria-hidden="true"></canvas>

  <%- include('partials/sidebar') %>
  <div class="shell">
    <%- include('partials/topbar') %>
    <main class="page">
      <%- body %>
    </main>
    <%- include('partials/footer') %>
  </div>

  <%- include('partials/control-panel') %>
  <%- include('partials/notifications') %>
  <%- include('partials/avatar-picker') %>
  <%- include('partials/ai-terminal') %>
  <%- include('partials/toast') %>

  <button id="fab-ai" class="fab" aria-label="Open AI assistant">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <path fill="currentColor" d="M12 2 9.6 8.4 3 11l6.6 2.6L12 20l2.4-6.4L21 11l-6.6-2.6z"/>
    </svg>
  </button>

  <script src="/js/app.js" defer></script>
</body>
</html>
