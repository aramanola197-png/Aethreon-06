<section class="util-page" data-util="discover">
  <form class="search-bar" data-search>
    <input type="text" name="q" placeholder="Search contributors — name, handle, address" autocomplete="off" />
    <button type="submit" class="search-exec" aria-label="Execute">
      <svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="m21 20-5.6-5.6A8 8 0 1 0 14.4 15.4L20 21zM4 10a6 6 0 1 1 12 0 6 6 0 0 1-12 0z"/></svg>
    </button>
  </form>

  <section class="instructions">
    <h3>Discover active contributors</h3>
    <ol>
      <li>Leave the field blank for the latest ecosystem cohort.</li>
      <li>Enter a query to search by name, handle or address.</li>
      <li>Tap any contributor card to open a full intelligence run.</li>
    </ol>
  </section>

  <section class="result" id="result" hidden></section>
</section>
