<section class="util-page" data-util="reputation">
  <form class="search-bar" data-search>
    <input type="text" name="q" placeholder="STX address — assess reputation" autocomplete="off" required />
    <button type="submit" class="search-exec" aria-label="Execute">
      <svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="m21 20-5.6-5.6A8 8 0 1 0 14.4 15.4L20 21zM4 10a6 6 0 1 1 12 0 6 6 0 0 1-12 0z"/></svg>
    </button>
  </form>

  <section class="instructions">
    <h3>Reputation scoring</h3>
    <ol>
      <li>Input any STX address.</li>
      <li>Execute the AETHREON scoring engine.</li>
      <li>Review the 0–1000 score and assigned tier.</li>
      <li>Inspect the five-axis breakdown.</li>
      <li>Save the profile or export a branded reputation card.</li>
    </ol>
  </section>

  <section class="result" id="result" hidden></section>
</section>
