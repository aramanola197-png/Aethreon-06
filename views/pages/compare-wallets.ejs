<section class="util-page" data-util="compare-wallets">
  <form class="search-bar compare-bar" data-search>
    <input type="text" name="a" placeholder="STX address A" autocomplete="off" required />
    <span class="vs">vs</span>
    <input type="text" name="b" placeholder="STX address B" autocomplete="off" required />
    <button type="submit" class="search-exec" aria-label="Execute">
      <svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="m21 20-5.6-5.6A8 8 0 1 0 14.4 15.4L20 21zM4 10a6 6 0 1 1 12 0 6 6 0 0 1-12 0z"/></svg>
    </button>
  </form>

  <section class="instructions">
    <h3>Side-by-side comparison</h3>
    <ol>
      <li>Provide two STX addresses.</li>
      <li>Execute the parallel resolution.</li>
      <li>Inspect both contributors across every axis simultaneously.</li>
      <li>Save the comparison or export a dual-profile card.</li>
    </ol>
  </section>

  <section class="result" id="result" hidden></section>
</section>
