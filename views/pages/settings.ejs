<section class="util-page" data-util="settings">
  <section class="settings-grid">

    <!-- Background Animation -->
    <div class="setting-card">
      <h3>Background Animation</h3>

      <label class="switch">
        <input type="checkbox" id="anim-toggle" checked />
        <span></span>
      </label>
    </div>

    <!-- Notifications -->
    <div class="setting-card">
      <h3>Notifications</h3>

      <label class="switch">
        <input type="checkbox" id="notif-toggle" checked />
        <span></span>
      </label>
    </div>

    <!-- Auto Save Searches -->
    <div class="setting-card">
      <h3>Auto Save Searches</h3>

      <label class="switch">
        <input type="checkbox" id="autosave-toggle" checked />
        <span></span>
      </label>
    </div>

    <!-- Export Quality -->
    <div class="setting-card">
      <h3>Export Quality</h3>

      <div class="theme-switch export-switch">
        <button class="active" data-export="standard">
          STANDARD
        </button>

        <button data-export="high">
          HIGH
        </button>

        <button data-export="ultra">
          ULTRA
        </button>
      </div>
    </div>

  </section>
</section>