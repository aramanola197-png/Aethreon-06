<section class="util-page" data-util="settings">
  <section class="settings-grid">
    <div class="setting-card">
      <h3>Theme</h3>
      <div class="theme-switch">
        <button data-theme="light">Light</button>
        <button data-theme="dark" class="active">Dark</button>
        <button data-theme="system">System</button>
      </div>
    </div>
    <div class="setting-card">
      <h3>Background animation</h3>
      <label class="switch"><input type="checkbox" id="anim-toggle" checked /><span></span></label>
    </div>
    <div class="setting-card">
      <h3>Notifications</h3>
      <label class="switch"><input type="checkbox" id="notif-toggle" checked /><span></span></label>
    </div>
    <div class="setting-card">
   <h3>Auto Save Searches</h3>

   <label class="toggle-switch">
      <input type="checkbox" checked>
      <span class="slider"></span>
   </label>
</div>
<div class="setting-card">
   <h3>Export Quality</h3>

   <div class="theme-options">
      <button class="theme-btn active">STANDARD</button>
      <button class="theme-btn">HIGH</button>
      <button class="theme-btn">ULTRA</button>
   </div>
</div>
  </section>
</section>
